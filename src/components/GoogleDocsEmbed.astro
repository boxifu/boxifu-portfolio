---
type Props = {
  url: string;
  title: string;
};

const { url, title } = Astro.props;
const src = url.includes("/preview") ? url : `${url.replace(/\/edit.*$/, "")}/preview`;
---

<figure class="embed embed--document">
  <iframe src={src} title={title} loading="lazy"></iframe>
  <figcaption>{title}</figcaption>
</figure>
