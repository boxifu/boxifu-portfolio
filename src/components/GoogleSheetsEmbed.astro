---
type Props = {
  url: string;
  title: string;
};

const { url, title } = Astro.props;
const parsedUrl = new URL(url);
const gid = parsedUrl.searchParams.get("gid") ?? parsedUrl.hash.match(/gid=(\d+)/)?.[1];
const baseUrl = `${parsedUrl.origin}${parsedUrl.pathname.replace(/\/(edit|pubhtml|preview).*$/, "")}/preview`;
const src = `${baseUrl}${gid ? `?gid=${gid}` : ""}`;
---

<figure class="embed embed--document">
  <iframe src={src} title={title} loading="lazy"></iframe>
  <figcaption>{title}</figcaption>
</figure>
