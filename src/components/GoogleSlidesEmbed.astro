---
type Props = {
  url: string;
  title: string;
};

const { url, title } = Astro.props;
const parsedUrl = new URL(url);
const baseUrl = `${parsedUrl.origin}${parsedUrl.pathname.replace(/\/(edit|present|embed|preview).*$/, "")}/preview`;
const src = baseUrl;
---

<figure class="embed embed--document">
  <iframe src={src} title={title} loading="lazy" allowfullscreen></iframe>
  <figcaption>{title}</figcaption>
</figure>
