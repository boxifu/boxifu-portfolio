---
import type { CollectionEntry } from "astro:content";

type Props = {
  project: CollectionEntry<"projects">;
};

const { project } = Astro.props;
const href = `${import.meta.env.BASE_URL}projects/${project.slug}/`;
---

<article class="project-card">
  <div class="project-card__meta">
    <span>{project.data.year}</span>
    <span>{project.data.status}</span>
  </div>
  <h2><a href={href}>{project.data.title}</a></h2>
  <p>{project.data.summary}</p>
  {
    project.data.tags.length > 0 && (
      <ul class="tag-list" aria-label={`${project.data.title} tags`}>
        {project.data.tags.map((tag) => (
          <li>{tag}</li>
        ))}
      </ul>
    )
  }
</article>
