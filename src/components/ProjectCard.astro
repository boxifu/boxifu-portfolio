---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../i18n/config";
import { getProjectSlug } from "../i18n/projects";

type Props = {
  project: CollectionEntry<"projects">;
  locale: Locale;
};

const { project, locale } = Astro.props;
const href = `${import.meta.env.BASE_URL}${locale}/projects/${getProjectSlug(project)}/`;
const media = project.data.media;
const mediaSrc = media.src?.startsWith("http")
  ? media.src
  : media.src
    ? `${import.meta.env.BASE_URL}${media.src.replace(/^\//, "")}`
    : "";
---

<article class="project-card">
  <div class="project-card__media" aria-label={`${project.data.title} media`}>
    {
      media.type === "image" && mediaSrc ? (
        <img src={mediaSrc} alt={media.alt ?? `${project.data.title} preview`} loading="lazy" />
      ) : media.type === "youtube" && media.src ? (
        <iframe
          src={`https://www.youtube-nocookie.com/embed/${media.src}`}
          title={`${project.data.title} video`}
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
        />
      ) : (
        <span>{project.data.title}</span>
      )
    }
  </div>
  <h2><a href={href}>{project.data.title}</a></h2>
  <p>{project.data.summary}</p>
  {
    project.data.tags.length > 0 && (
      <ul class="tag-list" aria-label={`${project.data.title} tags`}>
        {project.data.tags.map((tag) => (
          <li>{tag}</li>
        ))}
      </ul>
    )
  }
</article>
