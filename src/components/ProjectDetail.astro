---
import type { CollectionEntry } from "astro:content";
import GoogleDocsEmbed from "@components/GoogleDocsEmbed.astro";
import GoogleSheetsEmbed from "@components/GoogleSheetsEmbed.astro";
import GoogleSlidesEmbed from "@components/GoogleSlidesEmbed.astro";
import YouTubeEmbed from "@components/YouTubeEmbed.astro";
import type { Locale } from "../i18n/config";
import { useTranslations } from "../i18n/ui";

type Props = {
  project: CollectionEntry<"projects">;
  locale: Locale;
};

const { project, locale } = Astro.props;
const t = useTranslations(locale);
const heroStyle = project.data.heroImage
  ? `--project-hero-image: url("${import.meta.env.BASE_URL}${project.data.heroImage.src.replace(/^\//, "")}")`
  : undefined;
---

<article class="section project-detail">
  <a class="back-link" href={`${import.meta.env.BASE_URL}${locale}/projects/`}>{t.projects.backToProjects}</a>
  <header class:list={["project-detail__header", { "project-detail__header--image": project.data.heroImage }]} style={heroStyle}>
    <p class="eyebrow">{project.data.year} / {project.data.status}</p>
    <h1>{project.data.title}</h1>
    <p>{project.data.summary}</p>
    {
      project.data.role && (
        <p class="project-detail__role">
          <strong>{t.projects.role}</strong> {project.data.role}
        </p>
      )
    }
    {
      project.data.tags.length > 0 && (
        <ul class="tag-list" aria-label={`${project.data.title} tags`}>
          {project.data.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )
    }
  </header>

  {
    project.data.gallery.length > 0 && (
      <section class="project-gallery" aria-label={`${project.data.title} screenshots`}>
        {project.data.gallery.map((image) => (
          <figure>
            <img src={`${import.meta.env.BASE_URL}${image.src.replace(/^\//, "")}`} alt={image.alt} loading="lazy" />
            {image.caption && <figcaption>{image.caption}</figcaption>}
          </figure>
        ))}
      </section>
    )
  }

  <div class="prose">
    <slot />
  </div>

  {
    project.data.embeds.length > 0 && (
      <section class="project-tools" aria-labelledby="project-tools-heading">
        <h2 id="project-tools-heading">{t.projects.tools}</h2>
        {project.data.embeds.map((embed) => (
          <>
            {embed.type === "youtube" && embed.id && <YouTubeEmbed id={embed.id} title={embed.title} />}
            {embed.type === "googleSlides" && embed.url && <GoogleSlidesEmbed url={embed.url} title={embed.title} />}
            {embed.type === "googleDocs" && embed.url && <GoogleDocsEmbed url={embed.url} title={embed.title} />}
            {embed.type === "googleSheets" && embed.url && <GoogleSheetsEmbed url={embed.url} title={embed.title} />}
          </>
        ))}
      </section>
    )
  }

  {
    project.data.links.length > 0 && (
        <footer class="project-links">
          <h2>{t.projects.links}</h2>
        <ul>
          {project.data.links.map((link) => (
            <li>
              <a href={link.url}>{link.label}</a>
            </li>
          ))}
        </ul>
      </footer>
    )
  }
</article>
