---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../i18n/config";
import { useTranslations } from "../i18n/ui";

type Props = {
  project: CollectionEntry<"projects">;
  locale: Locale;
};

const { project, locale } = Astro.props;
const t = useTranslations(locale);
---

<article class="section project-detail">
  <a class="back-link" href={`${import.meta.env.BASE_URL}${locale}/projects/`}>{t.projects.backToProjects}</a>
  <header class="project-detail__header">
    <p class="eyebrow">{project.data.year} / {project.data.status}</p>
    <h1>{project.data.title}</h1>
    <p>{project.data.summary}</p>
    {
      project.data.role && (
        <p class="project-detail__role">
          <strong>{t.projects.role}</strong> {project.data.role}
        </p>
      )
    }
    {
      project.data.tags.length > 0 && (
        <ul class="tag-list" aria-label={`${project.data.title} tags`}>
          {project.data.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )
    }
  </header>

  <div class="prose">
    <slot />
  </div>

  {
    project.data.links.length > 0 && (
        <footer class="project-links">
          <h2>{t.projects.links}</h2>
        <ul>
          {project.data.links.map((link) => (
            <li>
              <a href={link.url}>{link.label}</a>
            </li>
          ))}
        </ul>
      </footer>
    )
  }
</article>
