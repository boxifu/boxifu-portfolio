---
import type { Locale } from "../i18n/config";
import { useTranslations } from "../i18n/ui";

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const currentYear = new Date().getFullYear();
const t = useTranslations(locale);
---

<footer class="site-footer">
  <section class="footer-contact" aria-labelledby="footer-contact-heading">
    <h2 id="footer-contact-heading">{t.footer.heading}</h2>
    <ul>
      <li><a href="mailto:boxifu@usc.edu">boxifu@usc.edu</a></li>
      <li><a href="tel:+12403103850">(240) 310 3850</a></li>
      <li><a href="https://boxifu.itch.io/">https://boxifu.itch.io/</a></li>
      <li><a href="https://www.linkedin.com/in/boxifu/">https://www.linkedin.com/in/boxifu/</a></li>
    </ul>
    <p>&copy; {currentYear} Boxi Fu. {t.footer.built}</p>
  </section>
</footer>
