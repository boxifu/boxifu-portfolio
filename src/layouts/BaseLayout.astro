---
import SiteFooter from "@components/SiteFooter.astro";
import SiteHeader from "@components/SiteHeader.astro";
import { defaultLocale, localeLanguageTags, type Locale } from "../i18n/config";
import "@styles/global.css";

type Props = {
  title: string;
  description: string;
  locale?: Locale;
  pageClass?: string;
};

const { title, description, locale = defaultLocale, pageClass } = Astro.props;
const siteTitle = title === "Boxifu" ? title : `${title} | Boxifu`;
---

<!doctype html>
<html lang={localeLanguageTags[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{siteTitle}</title>
  </head>
  <body class={pageClass}>
    <div class="page-shell">
      <SiteHeader locale={locale} />
      <main>
        <slot />
      </main>
      <SiteFooter locale={locale} />
    </div>
  </body>
</html>
