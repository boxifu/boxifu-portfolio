---
import BaseLayout from "@layouts/BaseLayout.astro";
import { locales, type Locale } from "../../i18n/config";
import { useTranslations } from "../../i18n/ui";

export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { locale },
    props: { locale },
  }));
}

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
const photoSrc = `${import.meta.env.BASE_URL}assets/images/about/boxi-fu-photo-01.jpg`;
const resumeFile =
  locale === "zh" ? "fu-boxi-resume-cn.pdf" : "fu-boxi-resume-game.pdf";
const resumeSrc = `${import.meta.env.BASE_URL}assets/pdfs/${resumeFile}`;
const resumeViewerSrc = `${resumeSrc}#zoom=100`;
---

<BaseLayout title={t.about.title} description={t.about.description} locale={locale}>
  <section class="section about-hero">
    <div class="about-hero__copy">
      <p class="eyebrow">{t.about.eyebrow}</p>
      <h1>{t.about.heading}</h1>
      <div class="about-hero__intro">
        {t.about.intro.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
    <figure class="about-photo">
      <img src={photoSrc} alt={t.about.photoAlt} />
    </figure>
  </section>

  <section class="section resume-section" aria-labelledby="resume-heading">
    <div class="section-heading">
      <h2 id="resume-heading">{t.about.resumeTitle}</h2>
      <div class="button-row">
        <a class="button" href={resumeSrc}>{t.about.resumeOpen}</a>
        <a class="button button--secondary" href={resumeSrc} download>{t.about.resumeDownload}</a>
      </div>
    </div>
    <iframe class="resume-frame" src={resumeViewerSrc} title={t.about.resumeTitle}></iframe>
  </section>
</BaseLayout>
