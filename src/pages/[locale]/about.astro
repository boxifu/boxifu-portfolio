---
import BaseLayout from "@layouts/BaseLayout.astro";
import { locales, type Locale } from "../../i18n/config";
import { useTranslations } from "../../i18n/ui";

export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { locale },
    props: { locale },
  }));
}

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
---

<BaseLayout title={t.about.title} description={t.about.description} locale={locale}>
  <section class="section page-intro">
    <p class="eyebrow">{t.about.eyebrow}</p>
    <h1>{t.about.heading}</h1>
    <p>{t.about.intro}</p>
  </section>

  <section class="section content-columns" aria-label={t.about.title}>
    {
      t.about.sections.map((section) => (
        <article>
          <h2>{section.title}</h2>
          <p>{section.body}</p>
        </article>
      ))
    }
  </section>
</BaseLayout>
