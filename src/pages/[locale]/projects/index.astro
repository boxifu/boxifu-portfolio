---
import { getCollection } from "astro:content";
import ProjectCard from "@components/ProjectCard.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { locales, type Locale } from "../../../i18n/config";
import { getLocalizedProjects, sortProjects } from "../../../i18n/projects";
import { useTranslations } from "../../../i18n/ui";

export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { locale },
    props: { locale },
  }));
}

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
const projects = sortProjects(getLocalizedProjects(await getCollection("projects"), locale));
const headingId = (category: string) => `${category.toLowerCase().replace(/[^a-z0-9]+/g, "-")}-heading`;
---

<BaseLayout title={t.projects.title} description={t.projects.description} locale={locale}>
  <section class="section page-intro">
    <p class="eyebrow">{t.projects.eyebrow}</p>
    <h1>{t.projects.heading}</h1>
    <p>{t.projects.intro}</p>
  </section>

  <section class="section" aria-labelledby="projects-list-heading">
    <div class="section-heading">
      <p class="eyebrow">{t.home.selectedWork}</p>
      <h2 id="projects-list-heading">{t.home.projects}</h2>
    </div>
    {
      t.projects.categories.map((category) => {
        const categoryProjects = projects.filter((project) => project.data.category === category.key);

        return (
          categoryProjects.length > 0 && (
            <section class="project-category" aria-labelledby={headingId(category.key)}>
              <h3 id={headingId(category.key)}>{category.label}</h3>
              <div class="project-grid project-grid--wide">
                {categoryProjects.map((project) => (
                  <ProjectCard project={project} locale={locale} />
                ))}
              </div>
            </section>
          )
        );
      })
    }
  </section>
</BaseLayout>
