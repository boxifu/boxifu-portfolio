---
import { getCollection } from "astro:content";
import ProjectCard from "@components/ProjectCard.astro";
import BaseLayout from "@layouts/BaseLayout.astro";

const featuredProjects = (await getCollection("projects"))
  .filter((project) => project.data.featured)
  .sort((a, b) => b.data.year - a.data.year);
---

<BaseLayout
  title="Boxifu"
  description="Academic and game developer portfolio focused on research, playable systems, and maintainable technical work."
>
  <section class="hero section">
    <p class="eyebrow">Academic work, game systems, and technical craft</p>
    <h1>Building readable systems for research, play, and learning.</h1>
    <p class="hero__lede">
      This portfolio collects academic work, game development projects, and technical experiments with an emphasis on clear
      documentation, thoughtful design, and sustainable engineering.
    </p>
    <div class="button-row">
      <a class="button" href={`${import.meta.env.BASE_URL}projects/`}>View projects</a>
      <a class="button button--secondary" href={`${import.meta.env.BASE_URL}about/`}>About</a>
    </div>
  </section>

  <section class="section split-section" aria-labelledby="focus-heading">
    <div>
      <p class="eyebrow">Focus</p>
      <h2 id="focus-heading">A portfolio built for depth, not noise.</h2>
    </div>
    <div class="feature-grid">
      <article>
        <h3>Research-minded</h3>
        <p>Space for academic context, methods, publications, presentations, and reflective project writing.</p>
      </article>
      <article>
        <h3>Game developer ready</h3>
        <p>Project pages can grow to include roles, design goals, technical notes, playable builds, media, and source links.</p>
      </article>
      <article>
        <h3>Easy to extend</h3>
        <p>Reusable layouts and Markdown content make future edits straightforward for both humans and coding agents.</p>
      </article>
    </div>
  </section>

  <section class="section" aria-labelledby="featured-heading">
    <div class="section-heading">
      <p class="eyebrow">Selected work</p>
      <h2 id="featured-heading">Featured projects</h2>
    </div>
    <div class="project-grid">
      {featuredProjects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>
</BaseLayout>
