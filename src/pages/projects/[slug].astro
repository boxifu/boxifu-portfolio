---
import { getCollection } from "astro:content";
import { localizedPath, pathWithBase } from "../../i18n/config";
import { getLocalizedProjects, getProjectSlug } from "../../i18n/projects";

export async function getStaticPaths() {
  const projects = getLocalizedProjects(await getCollection("projects"), "en");

  return projects.map((project) => ({
    params: { slug: getProjectSlug(project) },
    props: { slug: getProjectSlug(project) },
  }));
}

const { slug } = Astro.props;
const target = pathWithBase(localizedPath("en", `/projects/${slug}/`));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <title>Project | Boxifu</title>
  </head>
  <body>
    <p><a href={target}>Continue to English project page</a></p>
  </body>
</html>
